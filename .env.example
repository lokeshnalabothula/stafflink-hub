# Environment Variables Configuration Example
# Copy this file to .env.local and fill in your actual values
# .env.local is Git-ignored and should never be committed

# =============================================
# SUPABASE CONFIGURATION
# =============================================
# Get these from your Supabase project settings
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anonymous-key-here

# =============================================
# API CONFIGURATION
# =============================================
# Update if you have a backend API
VITE_API_URL=http://localhost:3000

# =============================================
# APPLICATION CONFIGURATION
# =============================================
# Base URL for GitHub Pages (handled automatically in most cases)
# For project repositories: /repository-name/
# For user/org pages: /
VITE_BASE_URL=/

# =============================================
# DEVELOPMENT CONFIGURATION
# =============================================
# Enable debug logging (for development only)
VITE_DEBUG=false

# Feature flags
VITE_ENABLE_2FA=true
VITE_ENABLE_OTP_LOGIN=true
